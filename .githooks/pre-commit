#!/usr/bin/env sh
# Enabled with: git config core.hooksPath .githooks
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

# Staged files matching the given pathspecs, one per line.
staged() { git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -- "$@"; }

fail() {
	echo "pre-commit: $*" >&2
	exit 1
}

# Whitespace errors (trailing whitespace, conflict markers) in staged changes.
git diff --cached --check

swift_files=$(staged '*.swift')
plist_files=$(staged '*.plist' '*.pbxproj')
json_files=$(staged '*.xcstrings' '*.icon/icon.json' '.swift-format' 'release-please-config.json' '.release-please-manifest.json')
# Anything that can change the result of the tests, including deletions.
test_inputs=$(git diff --cached --name-only -- src tests resources LockTheDock.xcodeproj)

if [ -n "$swift_files$plist_files$test_inputs" ]; then
	command -v xcrun >/dev/null 2>&1 || fail "Xcode is required but not installed."
fi

# The checks below read the staged content, not whatever is in the working tree.

# Swift: formatting and lint rules, as in CI.
if [ -n "$swift_files" ]; then
	echo "pre-commit: swift-format"
	status=0
	while IFS= read -r file; do
		git show ":$file" | xcrun swift-format lint --strict --assume-filename "$file" - || status=1
	done <<LIST
$swift_files
LIST
	[ "$status" -eq 0 ] ||
		fail "fix with 'xcrun swift-format format --in-place --recursive src tests', then re-stage."
fi

# Property lists and the Xcode project.
if [ -n "$plist_files" ]; then
	while IFS= read -r file; do
		git show ":$file" | plutil -lint -s - || fail "'$file' is not a valid property list."
	done <<LIST
$plist_files
LIST
fi

# JSON files.
if [ -n "$json_files" ]; then
	while IFS= read -r file; do
		git show ":$file" | python3 -m json.tool >/dev/null || fail "'$file' is not valid JSON."
	done <<LIST
$json_files
LIST
fi

# Tests. Unlike the checks above, these build the working tree.
if [ -n "$test_inputs" ]; then
	echo "pre-commit: tests"
	mkdir -p build
	# Git sets variables for hooks that would confuse any Git command xcodebuild runs.
	(
		unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE
		xcodebuild test -quiet \
			-project LockTheDock.xcodeproj \
			-scheme LockTheDock \
			-destination 'platform=macOS' \
			-derivedDataPath build/hook \
			CODE_SIGN_IDENTITY=- \
			DEVELOPMENT_TEAM=
	) >build/pre-commit-tests.log 2>&1 || {
		tail -n 40 build/pre-commit-tests.log >&2
		fail "tests failed. Full log: build/pre-commit-tests.log"
	}
fi
