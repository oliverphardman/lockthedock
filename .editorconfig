root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.swift]
indent_size = 4
tab_width = 4
max_line_length = 120

[*.plist]
indent_size = 4

[{*.sh,.githooks/*,*.pbxproj,.vscode/*.json}]
indent_style = tab

[{*.xcstrings,**.icon/icon.json}]
insert_final_newline = unset

[*.md]
trim_trailing_whitespace = false
